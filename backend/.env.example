# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit real values.
# No secrets belong here: AWS credentials stay in your AWS CLI profile.

# AWS region where the Bedrock models are enabled
BEDROCK_REGION=us-east-1
# Bedrock model ID (or inference profile ID) for text prompts
BEDROCK_TEXT_MODEL=
# Bedrock model ID (or inference profile ID) for prompts with images
BEDROCK_VISION_MODEL=
# Name of the AWS CLI profile to use (see: aws configure list-profiles)
AWS_PROFILE=
# true to call Bedrock, false to run without AI
AI_ENABLED=false
# Existing switch for the practice form feature
FORM_ENABLED=true
